      grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
      gap: 16px;
    }

    .skill {
      padding: 22px 12px;
      text-align: center;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      transition: .25s;
    }

    .skill:hover {
      transform: translateY(-6px);
      border-color: rgba(66,165,255,.45);
    }

    .skill i {

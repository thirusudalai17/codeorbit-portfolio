<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sudalai - Full Stack Developer Portfolio" />
  <title>Sudalai | Full Stack Developer</title>

  <!-- Devicon provides professional technology logos -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

  <style>
    :root {
      --bg: #07111f;
      --bg-soft: #0d1b2e;
      --card: rgba(18, 35, 56, 0.78);
      --text: #f4f7fb;
      --muted: #a9b7c8;
      --primary: #42a5ff;
      --secondary: #7c5cff;
      --border: rgba(255,255,255,.10);
      --shadow: 0 20px 60px rgba(0,0,0,.25);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 15% 15%, rgba(66,165,255,.16), transparent 30%),
        radial-gradient(circle at 85% 10%, rgba(124,92,255,.16), transparent 28%),
        var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a { color: inherit; text-decoration: none; }
    .container { width: min(1120px, 92%); margin: auto; }

    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      backdrop-filter: blur(14px);
      background: rgba(7,17,31,.75);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      height: 72px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: .5px;
    }

    .logo span { color: var(--primary); }

    .nav-links {
      display: flex;
      gap: 26px;
      list-style: none;
    }

    .nav-links a {
      color: var(--muted);
      font-size: .95rem;
      transition: .25s;
    }

    .nav-links a:hover { color: var(--text); }

    .hero {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 120px 0 70px;
    }


    .hero-layout {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 55px;
      width: 100%;
    }

    .profile-photo {
      width: 270px;
      height: 270px;
      object-fit: cover;
      border-radius: 50%;
      border: 5px solid rgba(255,255,255,.9);
      box-shadow: 0 18px 50px rgba(0,0,0,.35);
      flex: 0 0 auto;
    }


    .hero-about-card {
      margin: 24px auto 0;
      padding: 20px 24px;
      max-width: 650px;
      text-align: left;
      background: rgba(18, 35, 56, 0.78);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .hero-about-card h2 {
      font-size: 1.25rem;
      margin-bottom: 7px;
    }

    .hero-about-card p {
      color: var(--muted);
      font-size: .98rem;
      line-height: 1.6;
    }

    .hero-content {
      max-width: 700px;
    }

    @media (max-width: 800px) {
      .hero-layout {
        flex-direction: column;
        gap: 30px;
      }

      .profile-photo {
        width: 210px;
        height: 210px;
      }
    }

    .hero-content {
      max-width: 850px;
      text-align: center;
    }

    .badge {
      display: inline-block;
      padding: 8px 15px;
      border: 1px solid rgba(66,165,255,.3);
      border-radius: 999px;
      color: #bfe4ff;
      background: rgba(66,165,255,.08);
      margin-bottom: 20px;
      font-size: .9rem;
    }

    h1 {
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: .98;
      margin-bottom: 22px;
      letter-spacing: -3px;
    }

    h1 span {
      background: linear-gradient(90deg, var(--primary), #b18cff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 680px;
      margin: auto;
      color: var(--muted);
      font-size: 1.12rem;
    }

    .buttons {
      margin-top: 32px;
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 12px 21px;
      border-radius: 10px;
      font-weight: 700;
      border: 1px solid var(--border);
      transition: .25s;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      border: 0;
    }

    .btn-secondary { background: rgba(255,255,255,.05); }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,0,0,.2); }

    section { padding: 90px 0; }

    .section-title {
      text-align: center;
      margin-bottom: 42px;
    }

    .section-title h2 { font-size: 2.2rem; margin-bottom: 8px; }
    .section-title p { color: var(--muted); }

    .about-card, .contact-card, .project-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: var(--shadow);
    }

    .about-card {
      padding: 34px;
      text-align: center;
      max-width: auto;
      margin: auto;
    }

    .about-card p { color: var(--muted); font-size: 1.05rem; }

    
/* Navigation */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8%;
  background: #ffffff;
}

.logo {
  font-size: 26px;
  font-weight: 700;
  color: #172554;
  text-decoration: none;
}

.logo span {
  color: #2563eb;
}

.nav-links {
  display: flex;
  gap: 28px;
  list-style: none;
}

.nav-links a {
  position: relative;
  text-decoration: none;
  color: #1e293b;
  font-weight: 500;
  padding-bottom: 6px;
  transition: color 0.3s ease;
}

/* Hover underline animation */
.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 2px;
  background: #2563eb;
  transition: width 0.3s ease;
}

.nav-links a:hover {
  color: #2563eb;
}

.nav-links a:hover::after {
  width: 100%;
}

/* Projects section */
.projects-section {
  padding: 80px 8%;
  background: #f8fafc;
  scroll-margin-top: 30px;
}

.section-heading {
  text-align: center;
  margin-bottom: 45px;
}

.section-tag {
  color: #2563eb;
  font-weight: 700;
  letter-spacing: 3px;
  font-size: 13px;
}

.section-heading h2 {
  font-size: 38px;
  color: #0f172a;
  margin: 12px 0;
}

.section-heading h2 span {
  color: #2563eb;
}

.section-description {
  color: #64748b;
  font-size: 16px;
}

.projects-container {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  max-width: 1000px;
  margin: auto;
}

.project-card {
  background: #ffffff;
  padding: 32px;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
  transition: transform 0.3s ease, box-shadow 0.3s ease,
              border-color 0.3s ease;
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: #93c5fd;
  box-shadow: 0 15px 35px rgba(37, 99, 235, 0.12);
}

.project-number {
  color: #2563eb;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 18px;
}

.project-card h3 {
  color: #0f172a;
  font-size: 21px;
  margin-bottom: 14px;
}

.project-card p {
  color: #64748b;
  line-height: 1.8;
  margin-bottom: 20px;
}

.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 25px;
}

.project-tech span {
  background: #eff6ff;
  color: #1d4ed8;
  padding: 7px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}

.project-btn {
  display: inline-block;
  text-decoration: none;
  background: #2563eb;
  color: #ffffff;
  padding: 11px 20px;
  border-radius: 8px;
  font-weight: 600;
  transition: background 0.3s ease;
}

.project-btn:hover {
  background: #1d4ed8;
}

/* Mobile responsive */
@media (max-width: 650px) {
  .navbar {
    padding: 18px 5%;
    flex-wrap: wrap;
    gap: 18px;
  }

  .nav-links {
    gap: 15px;
    flex-wrap: wrap;
    padding: 0;
  }

  .nav-links a {
    font-size: 13px;
  }

  .projects-section {
    padding: 55px 5%;
  }

  .section-heading h2 {
    font-size: 30px;
  }

  .projects-container {
    grid-template-columns: 1fr;
  }

  .project-card {
    padding: 24px;
  }
}


    .skills-grid {
